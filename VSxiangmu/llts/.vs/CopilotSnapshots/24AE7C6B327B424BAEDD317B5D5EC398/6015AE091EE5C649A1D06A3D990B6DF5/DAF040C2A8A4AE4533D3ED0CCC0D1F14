// 明确声明 MFPlay API 类型和常量
#ifndef MFP_MEDIA_PLAYER_EVENT_TYPE
#include <mfplay.h>
#endif

// 链接需要的库
#pragma comment(lib, "mf.lib")
#pragma comment(lib, "mfplat.lib")
#pragma comment(lib, "mfplay.lib")
#pragma comment(lib, "shlwapi.lib")

// 全局播放器对象
IMFPMediaPlayer* 全局播放器 = NULL;
// 标记视频是否播放完成
BOOL 播放完成标记 = FALSE;

// ==============================
// 播放器事件回调（播放结束时触发）
// ==============================
HRESULT __stdcall 播放器回调(HWND hwnd, MFP_MEDIA_PLAYER_EVENT_TYPE eventType, IUnknown* pEvent, HRESULT result)
{
    // 如果事件是：媒体播放完毕
    if (eventType == MFP_MEDIA_PLAYER_EVENT_ENDOFSTREAM)
    {
        播放完成标记 = TRUE;
    }
    return S_OK;
}

// ==============================
// 获取程序 exe 所在的目录（绝对路径）
// 不受工作目录影响，最稳定
// ==============================
wstring 获取程序所在目录()
{
    // 定义路径缓冲区
    WCHAR 程序全路径[MAX_PATH] = { 0 };

    // 获取当前 exe 文件的完整路径（C:\xxx\xx.exe）
    GetModuleFileNameW(NULL, 程序全路径, MAX_PATH);

    // 去掉文件名，只保留目录（C:\xxx\）
    PathRemoveFileSpecW(程序全路径);

    // 返回目录，并在末尾加 \
    return wstring(程序全路径) + L"\\";
}

// ==============================
// 创建：全屏、置顶、无边框窗口
// ==============================
HWND 创建全屏置顶窗口()
{
    // 注册窗口类
    WNDCLASSEX 窗口类 = { 0 };
    窗口类.cbSize = sizeof(窗口类);
    窗口类.lpfnWndProc = DefWindowProcW;       // 使用默认窗口过程
    窗口类.hInstance = GetModuleHandleW(NULL); // 程序实例句柄
    窗口类.lpszClassName = L"自定义视频窗口";   // 窗口类名
    RegisterClassExW(&窗口类);

    // 获取屏幕分辨率
    int 屏幕宽度 = GetSystemMetrics(SM_CXSCREEN);
    int 屏幕高度 = GetSystemMetrics(SM_CYSCREEN);

    // 创建窗口
    // 样式：WS_POPUP → 无边框
    // 扩展：WS_EX_TOPMOST → 置顶
    HWND 窗口句柄 = CreateWindowExW(
        WS_EX_TOPMOST,            // 窗口置顶
        L"自定义视频窗口",        // 窗口类名
        L"",                      // 窗口标题（为空）
        WS_POPUP | WS_VISIBLE,    // 无边框 + 显示
        0, 0,                     // 起点坐标(0,0)
        屏幕宽度, 屏幕高度,        // 宽高 = 全屏
        NULL, NULL, 窗口类.hInstance, NULL
    );

    // 强制设置为最顶层窗口
    SetWindowPos(窗口句柄, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE);

    // 激活窗口，确保显示在最前
    SetForegroundWindow(窗口句柄);

    return 窗口句柄;
}

// ==============================
// 主函数：程序入口
// ==============================
int WINAPI WinMain(HINSTANCE hInst, HINSTANCE, LPSTR, int)
{
    // 1. 初始化媒体基础框架
    MFStartup(MF_VERSION);

    // 2. 创建全屏置顶无边框窗口
    HWND 主窗口 = 创建全屏置顶窗口();

    // 3. 创建系统底层播放器对象
    HRESULT hr = MFCreateMediaPlayer(
        播放器回调,       // 播放事件回调
        TRUE,            // 自动播放
        0,
        主窗口,          // 视频渲染到这个窗口
        hInst,
        &全局播放器
    );
    if (FAILED(hr) || !全局播放器) {
        MessageBoxW(NULL, L"播放器创建失败", L"错误", MB_ICONERROR);
        return -1;
    }

    // 4. 获取程序目录，拼接 llts.mp4 路径
    wstring 程序目录 = 获取程序所在目录();
    wstring 视频路径 = 程序目录 + L"llts.mp4";

    // 5. 设置要播放的文件
    hr = 全局播放器->CreateMediaItemFromURL(视频路径.c_str(), TRUE, 0, NULL);
    if (FAILED(hr)) {
        MessageBoxW(NULL, L"无法加载视频文件", L"错误", MB_ICONERROR);
        全局播放器->Release();
        MFShutdown();
        DestroyWindow(主窗口);
        return -1;
    }
    全局播放器->Play();

    // 6. 循环等待，直到播放完成
    MSG 消息;
    while (播放完成标记 == FALSE)
    {
        // 处理窗口消息，防止窗口卡死
        if (PeekMessageW(&消息, NULL, 0, 0, PM_REMOVE))
        {
            DispatchMessageW(&消息);
        }
        // 稍微降低CPU占用
        Sleep(10);
    }

    // 7. 播放完成，清理资源
    全局播放器->Stop();
    全局播放器->Release();
    MFShutdown();          // 关闭媒体框架
    DestroyWindow(主窗口); // 销毁窗口

    // 8. 退出程序
    return 0;
}